__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
# Kit's data folder never lives in the repo
data/
secrets/
*.secret

# Desk app installer builds
packaging/windows/build/
src/kit/desk/_build.py

# The docs vault: Obsidian's per-person state stays out of the repo
docs/.obsidian/workspace*.json
docs/.obsidian/cache
docs/.obsidian/plugins/
docs/.trash/

# The Pod's own secrets (copied from the .example.h files)
pod/firmware/*/wifi_settings.h
pod/firmware/*/kit_server.h
# Files the Pod's CAD script makes
pod/cad/*.step
pod/cad/*.stl
pod/cad/assembly/
pod/cad/render/

# Kit for Android's builds (android/)
android/.gradle/
android/**/build/
android/.kotlin/
android/core/.gradle/
android/core/.kotlin/
android/local.properties
