{
  "manifest_version": 3,
  "name": "Kit",
  "version": "0.1.0",
  "description": "Lets Kit, Dan's desk assistant, see which sites and tabs are open. Sends only to the Kit desk app on this PC.",
  "key": "",
  "permissions": ["tabs", "alarms", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Kit", "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "incognito": "not_allowed"
}
